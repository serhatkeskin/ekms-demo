.comments-section {
    margin-top: 2rem;
    padding: 1.5rem;
    background-color: #ffffff;
    border-radius: 8px;
    box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.05);
  }
  
  .comment-item {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .comment-item:last-child {
    border-bottom: none;
  }
  
  .comment-replies {
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 2px solid rgba(0, 0, 0, 0.1);
  }